{
  "name": "pol",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-to-browser file transfer. Nothing is uploaded.",
  "scripts": {
    "dev": "vite",
    "dev:signal": "node --env-file-if-exists=.env server/signal.mjs",
    "start": "node --env-file-if-exists=.env server/signal.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "matrix": "node scripts/browser-matrix.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "demo": "node scripts/demo.mjs",
    "cli": "tsx cli/pol.ts",
    "bench": "node scripts/bench.mjs"
  },
  "dependencies": {
    "node-datachannel": "^0.33.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "jsqr": "^1.4.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
