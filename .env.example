# Copy to .env for local development. Never commit the real .env.
# Managed TURN (metered.ca free tier, 20 GB/month):
#   app name from the dashboard URL (the part before .metered.live)
METERED_APP=
#   API key of the TURN credential (Show API Key in the dashboard)
METERED_KEY=

# Self-hosted TURN alternative (coturn). Used only when METERED_* is absent.
# TURN_URLS=turn:turn.example.com:3478
# TURN_SECRET=
# TURN_TTL=3600
